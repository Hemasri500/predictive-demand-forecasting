# Python virtual environment
venv/
.venv/

# Python cache
__pycache__/
*.py[cod]

# Environment variables / secrets
.env
*.env

# Raw and generated datasets
data/raw/*
data/processed/*
data/forecasts/*

# Keep the directories in Git
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/forecasts/.gitkeep

# Trained model artifacts
models/*.joblib
models/*.pkl

# Jupyter
.ipynb_checkpoints/

# Logs
logs/*
!logs/.gitkeep

# OS / IDE files
.DS_Store
Thumbs.db
.vscode/